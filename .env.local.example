# Server-side only. Postgres connection string for drizzle + TanStack Start server functions.
# Never exposed to the client bundle. Example: postgres://user:pass@localhost:5432/lead_metrics
DATABASE_URL=<YOUR_DATABASE_URL>

# Optional. Credentials for the local `pnpm db:seed` head user (defaults shown).
SEED_EMAIL=head@example.com
SEED_PASSWORD=password123
