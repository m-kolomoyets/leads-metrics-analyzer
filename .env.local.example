# Base URL the SPA uses to reach the backend API (see server/).
VITE_API_URL=http://localhost:9787/

# Enables MSW. This should be used for local development purposes only.
VITE_USE_MSW=true

# Server-side only. Postgres connection string for drizzle (API server + migrations).
# Never exposed to the client bundle. Example: postgres://user:pass@localhost:5432/lead_metrics
DATABASE_URL=<YOUR_DATABASE_URL>

# Port the backend API listens on (defaults to 9787).
API_PORT=9787

# Origin allowed to call the API via CORS (the SPA dev server). Defaults to http://localhost:9777.
WEB_ORIGIN=http://localhost:9777
